<Window x:Class="MCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MCLauncher" Height="680" Width="980"
        MinHeight="520" MinWidth="780"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="5" CaptionHeight="0"
                      CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ══════════════════════════════════════════
             CollectionViewSources — أسماء ثابتة، لا تغيرها
             ══════════════════════════════════════════ -->
        <CollectionViewSource x:Key="versionListViewRelease"  IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewBeta"     IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewPreview"  IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewImported" IsLiveFilteringRequested="True"/>

        <!-- ══════════════════════════════════════════
             Converters
             ══════════════════════════════════════════ -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ══════════════════════════════════════════
             Colors & Brushes
             ══════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BgWindow"       Color="#12131A"/>
        <SolidColorBrush x:Key="BgSidebar"      Color="#0D0E14"/>
        <SolidColorBrush x:Key="BgContent"      Color="#15161E"/>
        <SolidColorBrush x:Key="BgCard"         Color="#1E2030"/>
        <SolidColorBrush x:Key="BgHeader"       Color="#191B26"/>
        <SolidColorBrush x:Key="Border"         Color="#252840"/>
        <SolidColorBrush x:Key="AccentGreen"    Color="#4EC94E"/>
        <SolidColorBrush x:Key="AccentGreenDim" Color="#1A3D1A"/>
        <SolidColorBrush x:Key="AccentOrange"   Color="#E8A838"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#4A90D9"/>
        <SolidColorBrush x:Key="AccentRed"      Color="#E05252"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#DDE1F0"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#6B7099"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#3E4260"/>

        <!-- ══════════════════════════════════════════
             Button: Primary (Green)
             ══════════════════════════════════════════ -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4EC94E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DB83D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EA02E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: Danger (Red) -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: Ghost (Outline) -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2030"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: Flat (Sidebar tool links) -->
        <Style x:Key="BtnFlat" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Margin="8,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1C28"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: Window chrome (min/max) -->
        <Style x:Key="BtnChrome" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252840"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: Close (red hover) -->
        <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnChrome}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════
             Nav RadioButton (Sidebar)
             ══════════════════════════════════════════ -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SideNav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Active indicator bar -->
                                <Border x:Name="ActiveBar" Grid.Column="0" Background="#4EC94E"
                                        CornerRadius="2" Margin="-16,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151723"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                <Setter Property="Foreground" Value="#4EC94E"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             ProgressBar
             ══════════════════════════════════════════ -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="#252840"/>
            <Setter Property="Foreground" Value="#4EC94E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                            <!-- Indeterminate animation -->
                            <Rectangle x:Name="Animation" Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left" Width="100" CornerRadius="2">
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Rectangle.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                    From="-100,0,0,0" To="400,0,0,0" Duration="0:0:1.5"
                                                    AutoReverse="False"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="False">
                                <Setter TargetName="Animation" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             ScrollViewer Style (thin dark scrollbar)
             ══════════════════════════════════════════ -->
        <Style x:Key="ThinScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Style>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="5"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ScrollBar.Style>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             CheckBox Style
             ══════════════════════════════════════════ -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                    Background="#1E2030" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock x:Name="Check" Text="✓" FontSize="9" FontWeight="Bold"
                                           Foreground="#4EC94E" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4EC94E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             ListBox: transparent, no selection chrome
             ══════════════════════════════════════════ -->
        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             VERSION CARD TEMPLATES
             ══════════════════════════════════════════ -->

        <!-- Not Installed -->
        <DataTemplate x:Key="templateVersionNotInstalled">
            <Border Background="{StaticResource BgCard}" CornerRadius="8"
                    Margin="0,0,0,6" Padding="18,14" BorderThickness="1" BorderBrush="#1E2040">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#000010"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding DisplayInstallStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="↓  Download" Style="{StaticResource BtnPrimary}"
                            Command="{Binding DownloadCommand}" CommandParameter="{Binding}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Installed -->
        <DataTemplate x:Key="templateVersionInstalled">
            <Border Background="{StaticResource BgCard}" CornerRadius="8"
                    Margin="0,0,0,6" Padding="18,14" BorderThickness="1" BorderBrush="#1E3A1E">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#000010"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="{StaticResource AccentGreenDim}" CornerRadius="4"
                                    Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="INSTALLED" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreen}" LetterSpacing="0.5"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayInstallStatus}" FontSize="11"
                                   Foreground="{StaticResource AccentGreen}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove" Style="{StaticResource BtnDanger}"
                            Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="▶  Launch" Style="{StaticResource BtnPrimary}"
                            Command="{Binding LaunchCommand}" CommandParameter="{Binding}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Downloading / State Change -->
        <DataTemplate x:Key="templateVersionDownloading">
            <Border Background="{StaticResource BgCard}" CornerRadius="8"
                    Margin="0,0,0,6" Padding="18,14" BorderThickness="1" BorderBrush="#1A2040">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#000010"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding StateChangeInfo.DisplayStatus}"
                               FontSize="11" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,0"/>

                    <Canvas Grid.Row="2" Grid.Column="0" Margin="0,6,12,0">
                        <ProgressBar
                            Style="{StaticResource ModernProgressBar}"
                            Height="3"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                            Maximum="{Binding StateChangeInfo.MaxProgress}"
                            Value="{Binding StateChangeInfo.Progress}"
                            IsIndeterminate="{Binding StateChangeInfo.IsProgressIndeterminate}"/>
                    </Canvas>

                    <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                            Content="✕  Cancel"
                            Style="{StaticResource BtnGhost}"
                            Command="{Binding StateChangeInfo.CancelCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ControlTemplate for ContentControl — يطبق الـ DataTriggers -->
        <ControlTemplate x:Key="VersionListTemplate" TargetType="ContentControl">
            <ListBox ItemsSource="{TemplateBinding Content}" Style="{StaticResource CleanListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate"
                                            Value="{StaticResource templateVersionNotInstalled}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="ContentTemplate"
                                                    Value="{StaticResource templateVersionInstalled}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStateChanging}" Value="True">
                                            <Setter Property="ContentTemplate"
                                                    Value="{StaticResource templateVersionDownloading}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ControlTemplate>

        <!-- TabControl Style (مخفي — بنتحكم فيه بالـ sidebar) -->
        <Style x:Key="HiddenTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <!-- فقط الـ content، بدون Tab headers -->
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  WINDOW SHELL                                           ║
         ╚══════════════════════════════════════════════════════════╝ -->
    <Border Background="{StaticResource BgWindow}" CornerRadius="10"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="36"/>   <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ╔══════════ TITLE BAR ══════════╗ -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebar}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + App Name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <TextBlock Text="⛏" FontSize="16" Foreground="#4EC94E"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="MCLauncher" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  Bedrock Version Manager" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Style="{StaticResource BtnChrome}"
                                Click="MinimizeBtn_Click" ToolTip="Minimize"/>
                        <Button Content="□" Style="{StaticResource BtnChrome}"
                                Click="MaximizeBtn_Click" ToolTip="Maximize"/>
                        <Button Content="✕" Style="{StaticResource BtnClose}"
                                Click="CloseBtn_Click" ToolTip="Close"
                                Width="48" CornerRadius="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ╔══════════ CONTENT AREA ══════════╗ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Main -->
                </Grid.ColumnDefinitions>

                <!-- ┌──────── SIDEBAR ────────┐ -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section label -->
                        <TextBlock Grid.Row="0" Text="VERSIONS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="26,18,0,8" LetterSpacing="1.5"/>

                        <!-- Nav buttons -->
                        <StackPanel Grid.Row="1" Margin="0,4,0,0">
                            <RadioButton Style="{StaticResource NavBtn}" IsChecked="True"
                                         Click="NavRelease_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Release" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavBtn}" Click="NavBeta_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentOrange}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Beta" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavBtn}" Click="NavPreview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlue}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Preview" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavBtn}" Click="NavImported_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource TextSecondary}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Imported" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource Border}" Margin="18,14"/>

                            <!-- Tools Label -->
                            <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" Margin="26,0,0,6"
                                       LetterSpacing="1.5"/>

                            <!-- ⚠ IMPORTANT: تأكد إن أسماء الـ Click handlers دي موجودة في .cs -->
                            <Button Content="↻  Refresh Versions"    Style="{StaticResource BtnFlat}"
                                    Click="MenuItemRefreshVersionList_Click"/>
                            <Button Content="📂  Import Local Package" Style="{StaticResource BtnFlat}"
                                    Click="MenuItemImportLocalPackage_Click"/>
                            <Button Content="📋  Open Log File"        Style="{StaticResource BtnFlat}"
                                    Click="MenuItemOpenLogFile_Click"/>
                            <Button Content="📁  Open Data Folder"     Style="{StaticResource BtnFlat}"
                                    Click="MenuItemOpenDataFolder_Click"/>
                        </StackPanel>

                        <!-- Bottom: Show Installed Only -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource Border}"
                                BorderThickness="0,1,0,0" Padding="18,12">
                            <!-- x:Name must match what .cs references exactly -->
                            <CheckBox x:Name="ShowInstalledVersionsOnlyCheckbox"
                                      Content="Installed only" Style="{StaticResource DarkCheckBox}"
                                      Checked="ShowInstalledVersionsOnlyCheckbox_Checked"
                                      Unchecked="ShowInstalledVersionsOnlyCheckbox_Unchecked"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ┌──────── MAIN PANEL ────────┐ -->
                <Grid Grid.Column="1" Background="{StaticResource BgContent}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Section header -->
                        <RowDefinition Height="*"/>      <!-- Version list -->
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgHeader}"
                            Padding="24,16" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SectionTitle" Text="Release Versions"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="SectionSubtitle"
                                           Text="Stable public Minecraft Bedrock releases"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <!-- Options Menu (hidden but functional) -->
                            <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Foreground="{StaticResource TextSecondary}"
                                          FontSize="11" Background="{StaticResource BgCard}"
                                          BorderBrush="{StaticResource Border}">
                                    <MenuItem.Header>
                                        <TextBlock Text="⚙  Options" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </MenuItem.Header>
                                    <MenuItem Header="Uninstall All Versions"
                                              Click="MenuItemUninstallAll_Click"/>
                                    <MenuItem Header="Cleanup for Store Reinstall"
                                              Click="MenuItemCleanupForStoreInstall_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Find User Game Data"
                                              Click="MenuItemFindUserData_Click"/>
                                    <MenuItem Header="Set Version List Endpoint"
                                              Click="MenuItemSetVersionListEndpoint_Click"/>
                                </MenuItem>
                            </Menu>
                        </Grid>
                    </Border>

                    <!-- Version List (TabControl مخفي) -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,12,8,16">
                            <TabControl x:Name="VersionsTabControl"
                                        Style="{StaticResource HiddenTabControl}">
                                <TabItem>
                                    <ContentControl
                                        Template="{StaticResource VersionListTemplate}"
                                        Content="{Binding Source={StaticResource versionListViewRelease}}"/>
                                </TabItem>
                                <TabItem>
                                    <ContentControl
                                        Template="{StaticResource VersionListTemplate}"
                                        Content="{Binding Source={StaticResource versionListViewBeta}}"/>
                                </TabItem>
                                <TabItem>
                                    <ContentControl
                                        Template="{StaticResource VersionListTemplate}"
                                        Content="{Binding Source={StaticResource versionListViewPreview}}"/>
                                </TabItem>
                                <TabItem>
                                    <ContentControl
                                        Template="{StaticResource VersionListTemplate}"
                                        Content="{Binding Source={StaticResource versionListViewImported}}"/>
                                </TabItem>
                            </TabControl>
                        </ScrollViewer>

                        <!-- Loading overlay -->
                        <Grid x:Name="LoadingProgressGrid" Visibility="Collapsed"
                              Background="#BB12131A">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220"
                                             Style="{StaticResource ModernProgressBar}"/>
                                <TextBlock x:Name="LoadingProgressLabel"
                                           Text="Loading versions..."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" HorizontalAlignment="Center"
                                           Margin="0,14,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ╔══════════ STATUS BAR ══════════╗ -->
            <Border Grid.Row="2" Background="{StaticResource BgSidebar}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MCLauncher — Windows 10/11 Bedrock Multi-Version Manager"
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="GPL-3.0 · MCMrARM"
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
